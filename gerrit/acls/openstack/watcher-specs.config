[access]
	inheritFrom = openstack/meta-config

[access "refs/heads/*"]
	abandon = group watcher-specs-core
	label-Code-Review = -2..+2 group watcher-specs-core
	label-Review-Priority = +0..+1 group Registered Users
	label-Review-Priority = +0..+2 group watcher-specs-core
	label-Workflow = -1..+1 group watcher-specs-core

[label "Review-Priority"]
	copyCondition = changekind:NO_CODE_CHANGE OR is:ANY
	defaultValue = 0
	function = NoBlock
	value = 0 Standard Change
	value = +1 Important Change
	value = +2 High Priority Change

[submit-requirement "Review-Priority"]
	applicableIf = is:false
	description = Review Priority
	submittableIf = is:true
